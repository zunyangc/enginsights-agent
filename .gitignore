# Python (in case we add any local tooling)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node (in case we add any local tooling)
node_modules/

# Editor / OS
.idea/
.DS_Store
Thumbs.db

# Microsoft 365 Agents Toolkit
# Per-user secret env files (NEVER commit)
env/.env.*.user
env/.env.local
.localConfigs
# Build output — kept as an empty directory, contents ignored
appPackage/build/*
!appPackage/build/.gitkeep
# Toolkit-generated artefacts
appPackage/.generated

# Secrets / local env
.env
.env.*
!.env.example
*.pem
secrets/

# Azure CLI / Bicep build artefacts
*.bicepconfig.json.bak
azure.yaml
.azure/
